# ─────────────────────────────────────────────────────────────────────────────
# Jaydr GhostCart — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ghostcart:ghostcart_dev@localhost:5432/ghostcart
POSTGRES_PASSWORD=ghostcart_dev

# ── Redis / BullMQ Queue ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication (next-auth) ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_SECURE_SECRET
NEXTAUTH_URL=http://localhost:3000

# ── Dev Seed User (Stage 1 only — remove for production) ─────────────────────
DEV_SEED_EMAIL=dev@ghostcart.local
DEV_SEED_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Tenant Seed (Stage 1 fixture) ─────────────────────────────────────────────
DEV_TENANT_ID=tenant_dev_001

# ── Marketplace API Keys (stub — no real credentials until Stage 2+) ──────────
# @agent:atlas Populate these when implementing adapter integrations
EBAY_APP_ID=
EBAY_CERT_ID=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
# @agent:scout Add APM/tracing env vars when instrumenting Stage 4+

# ── URL Import Worker (Stage 2 pipeline) ─────────────────────────────────────────
# The BullMQ worker is a separate process from the Next.js app. Start it with:
#   npx tsx --env-file=.env src/worker/index.ts
# (or use the `worker` service in docker-compose.yml). It consumes the durable
# queue written by POST /api/products, resolves the supplier adapter (mock/csv/html),
# normalizes the product, and persists it. Without a running worker, URL imports
# stay "queued" forever. Requires REDIS_URL + DATABASE_URL (both set above).
# @agent:atlas If integrating a marketplace API adapter (e.g. AliExpress Open Platform
# app_key/app_secret), add those env vars here when implementing.
# ── Alerts (Stage 4 ops hardening) ────────────────────────────────────────────
# Comma-separated provider ids: console, webhook (default: console)
ALERTS_CHANNELS=console
# Webhook delivery URL (Slack/Gotify/Slack-compatible) if webhook channel enabled
ALERTS_WEBHOOK_URL=
# Minimum severity delivered to channels: info | warning | critical (default warning)
ALERTS_SEVERITY_MIN=warning
