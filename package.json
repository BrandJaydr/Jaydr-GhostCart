{
  "name": "jaydr-ghostcart",
  "version": "0.1.1",
  "private": true,
  "description": "Enterprise Reseller & Dropshipping Automation Platform — Stage 1 Scaffold",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "ts-node --esm src/worker/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "ts-node --esm src/db/migrate.ts",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "db:restore:test": "bash scripts/restore-test.sh",
    "secrets:verify": "bash scripts/verify-secret.sh",
    "secrets:rotate": "bash scripts/rotate-secrets.sh",
    "rules:verify": "node scripts/verify-rules.js"
  },
  "dependencies": {
    "@heroui/react": "^2.8.10",
    "bullmq": "5.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "ioredis": "5.3.2",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.15",
    "pg": "8.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/node": "20.14.9",
    "@types/pg": "8.11.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "7.16.0",
    "@typescript-eslint/parser": "7.16.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.4",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "jsdom": "^24.1.1",
    "postcss": "^8.5.26",
    "prettier": "3.3.3",
    "tailwindcss": "^3.4.19",
    "ts-node": "10.9.2",
    "typescript": "5.5.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "nanoid": "^3.3.18",
    "minimatch": "^9.0.5",
    "cookie": "^0.7.2",
    "esbuild": "^0.25.0",
    "glob": "^11.0.1",
    "postcss": "^8.5.26",
    "vite": "^6.4.3"
  }
}
